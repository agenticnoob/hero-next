{
  "name": "@viselora/hero-next",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "sync:journal": "node scripts/sync-journal.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "check:standalone": "node scripts/check-standalone.mjs",
    "check": "npm run lint && npm run format:check && npm test && npm run typecheck:tests && npm run check:standalone && npm run typecheck"
  },
  "dependencies": {
    "@viselora/dom-webgl": "0.1.0-alpha.2",
    "@viselora/scroll-adapters": "0.1.0-alpha.2",
    "gsap": "3.15.0",
    "lenis": "1.3.23",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/node": "24.13.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "26.1.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vitest": "3.2.6"
  },
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "packageManager": "npm@10.9.8"
